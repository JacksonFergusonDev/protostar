/* Tokens live in theme.py, which also names the styles Python writes inline
   after these variables. Panels are $surface on the $background, raised
   controls are $panel, and cyan ($accent) marks only focus, keys, and the
   primary action. */

* {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}
/* A disabled control says so in $text-disabled; Textual's fade on top of it
   would land between the palette's colors. */
*:disabled:can-focus { opacity: 1; }

Screen { background: $background; }

/* --- Frame ------------------------------------------------------------- */

Masthead { height: 1; padding: 0 2; background: $panel; }
#headline { height: auto; margin: 1 0 0 0; padding: 0 2; }
#title { width: auto; text-style: bold; color: $foreground; }
#subtitle { width: 1fr; margin-left: 1; color: $text-muted; }

/* A panel is ruled above and below only. It stays transparent so the rules,
   drawn on the inner edge of their rows, sit flush on the filled contents. */
Panel {
    height: 1fr;
    background: transparent;
    border-top: wide $hairline;
    border-bottom: wide $hairline;
}
Panel:focus-within { border-top: wide $accent; border-bottom: wide $accent; }
Panel > * { background: $surface; }
Panel > .panel-title { height: 1; padding: 0 1; color: $text-faint; text-style: bold; }
/* The shown tab takes the title's color, so it lights with focus too. */
TabbedPanel > .panel-title { color: $foreground; }
Panel:focus-within > .panel-title { color: $accent; }
TabbedPanel > ContentSwitcher { height: 1fr; }
/* The scrollbar meets the panel's edge. */
#editor, PlanPreview, #changes, #decisions, #files, #setup, #diff-pane,
#conflicts, .side, #result-pane {
    height: 1fr;
    padding: 0 0 0 1;
    background: $surface;
}

#editor-panel, #recipe-column { width: 3fr; }
#recipe-column > Panel { width: 1fr; }
/* Rows keep clear of the scrollbar; margins are set whole in Textual. */
#editor > * { margin: 0 2 0 0; }
#editor > .section, #editor > .group { margin: 1 2 0 0; }
/* The editor runs to the bottom; the buttons sit under the panel beside it. */
/* Each column is at least as wide as its buttons, which never overhang it. */
#aside { width: 2fr; min-width: 33; }
#review, #conflicts-panel { width: 2fr; }
#diff-column, #sides-column { width: 3fr; min-width: 45; }

/* --- Layout -------------------------------------------------------------
   Spacing belongs to the layout, never to the blocks it holds (chrome.py):
   one cell between columns, one row between the blocks of a column. Only
   this section sets a block's margin; sizes stay with each screen. */

#body { height: 1fr; margin: 0 1; }
Columns > * { margin: 0 0 0 1; }
Columns > *:first-child { margin: 0; }
/* A panel's bottom rule is the row between it and the panel under it. */
Column > Panel, Column > Panel:focus-within { border-top: none; }
Column > Panel:first-child { border-top: wide $hairline; }
Column > Panel:first-child:focus-within { border-top: wide $accent; }
Section { height: auto; margin: 0 0 1 0; }
Section > .section { margin: 0; }
/* The buttons end a row early, level with the last row of the panel beside
   them, whose bottom rule falls in the row below. */
Column > ActionBar { margin: 0 0 1 0; }

.section { height: 1; margin-top: 1; }
.group { margin-top: 1; padding-left: 1; text-style: bold; color: $text-muted; }
.note { color: $text-faint; }
.field-label { margin-top: 1; color: $text-muted; }
.field-error { height: auto; color: $error; }
.field-warning { color: $warning; }
VariableFields, MetadataFields, .field { height: auto; }

#preview-summary, #changes-summary { color: $text-muted; }
#subtitle.-error, #preview-summary.-error, #changes-summary.-error { color: $error; }
#preview-network, #network-note { color: $warning; margin-bottom: 1; }
#changes-diff { margin-top: 1; }
#template-status { height: auto; color: $text-muted; }

/* --- Controls ---------------------------------------------------------- */

Checkbox, RadioButton {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: transparent;
}
/* Lamps, unlit then lit: a checkbox's, a radio button's, and a list's. */
Checkbox > .toggle--button, RadioButton > .toggle--button,
SelectionList > .selection-list--button,
SelectionList > .selection-list--button-highlighted {
    color: $strut;
    background: $panel;
}
Checkbox.-on > .toggle--button, RadioSet > RadioButton.-on > .toggle--button,
SelectionList > .selection-list--button-selected,
SelectionList > .selection-list--button-selected-highlighted {
    color: $accent;
    background: $panel;
}
Checkbox:focus, RadioSet:focus > RadioButton.-selected {
    border: none;
    background: $glow;
    background-tint: $foreground 0%;
}
Checkbox:focus > .toggle--label,
RadioSet:focus > RadioButton.-selected > .toggle--label {
    color: $accent;
    background: transparent;
    text-style: bold;
}
Checkbox:blur:hover, RadioButton:hover { background: $panel; }
Checkbox:blur:hover > .toggle--label, RadioButton:hover > .toggle--label {
    background: transparent;
}
RadioSet:blur > RadioButton.-selected > .toggle--label { background: transparent; }
Checkbox:disabled > .toggle--label, RadioButton:disabled > .toggle--label {
    color: $text-disabled;
}

RadioSet, SelectionList {
    width: 1fr;
    height: auto;
    border: none;
    padding: 0;
    background: transparent;
}
RadioSet:focus, SelectionList:focus {
    border: none;
    background-tint: $foreground 0%;
}
SelectionList:blur > .option-list--option-highlighted { background: transparent; }

Select { width: 1fr; }
Select > SelectCurrent {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
}
Select:focus > SelectCurrent {
    border: none;
    background: $glow;
    color: $accent;
}
Select > SelectCurrent .arrow { color: $text-faint; }
Select:focus > SelectCurrent .arrow { color: $accent; }
/* What floats over a screen: a menu, a dialog. */
Select > SelectOverlay, #dialog {
    border: hkey $accent;
    background: $panel;
}

/* A one-row field has no room for the scrollbar `*` gives it: it would cover
   the text. The field scrolls to its cursor instead. */
Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
    scrollbar-size-horizontal: 0;
}
Input:focus {
    border: none;
    background: $glow;
    background-tint: $foreground 0%;
}
Input.-invalid, Input.-invalid:focus { background: $error 20%; border: none; }

Button {
    height: 1;
    min-width: 10;
    border: none;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    text-style: bold;
}
Button:hover { border: none; background: $hairline; }
Button:focus {
    background: $glow;
    color: $accent;
    background-tint: $foreground 0%;
}
Button.-primary { background: $accent; color: $background; }
Button.-error { background: $error; color: $background; }
Button.-primary:hover, Button.-primary:focus { background: $accent-lighten-2; }
Button.-error:hover, Button.-error:focus { background: $error-lighten-2; }
Button:disabled, Button.-primary:disabled {
    background: $panel;
    color: $text-disabled;
    text-opacity: 100%;
}
ActionBar { height: 1; align-horizontal: right; }
ActionBar Button { margin-left: 1; }

Tree { padding: 0; }
Tree:focus { background-tint: $foreground 0%; }
Tree > .tree--guides { color: $hairline; }
Tree > .tree--guides-hover { color: $strut; }
Tree > .tree--guides-selected { color: $accent; }
Tree > .tree--highlight-line { background: $panel; }

Footer { background: $panel; }

/* --- Review decisions -------------------------------------------------- */

/* One row of choices, so the diff above keeps the height. */
Choice#resolution { layout: horizontal; height: auto; width: 1fr; }
Choice#resolution RadioButton { width: auto; }
/* The sync screen offers four choices beside a narrower column: two rows. */
#choice { layout: grid; grid-size: 2; grid-rows: 1; height: auto; width: 1fr; }
#choice RadioButton { width: auto; }
#existing-panel { height: auto; }
#existing-note { color: $text-muted; }
ChoiceGroup { height: auto; }

/* --- Dialogs ----------------------------------------------------------- */

LeaveScreen, KeybindingsScreen, ToolInfoScreen, TierInfoScreen { align: center middle; background: $background 70%; }
#dialog {
    width: auto;
    max-width: 90;
    height: auto;
    padding: 1 2;
}
.dialog-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}
#dialog .question { text-style: bold; }
#dialog .note { margin-top: 1; }
/* On the dialog's $panel, a plain button rises a step. */
#dialog Button.-default { background: $hairline; }
.dialog-actions { width: auto; height: auto; margin-top: 1; }
.dialog-actions Button { margin-right: 2; }
KeybindingsScreen #dialog, ToolInfoScreen #dialog { width: 72; max-width: 100%; }
#dialog .info-heading { margin-top: 1; color: $text-faint; text-style: bold; }
TierInfoScreen #dialog { width: 90; max-width: 100%; }
TierFields { height: auto; }
.tier-turns-on { margin-top: 1; }
.tier-tool { height: auto; }
.tier-tool > Static { width: 1fr; height: auto; }
.tier-tool > .tier-tool-name { width: 24; }

/* --- Conflicts --------------------------------------------------------- */

#sides { height: 1fr; }
#sides > Panel { width: 1fr; }
#meaning { height: auto; }
