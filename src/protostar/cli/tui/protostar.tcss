Screen { background: $surface; }
#title { margin: 1 2 0 2; text-style: bold; color: $accent; }
#subtitle { margin: 0 2 1 2; color: $text-muted; }
#editor { padding: 0 2; }
.section { margin-top: 1; text-style: bold; color: $accent; }
Checkbox { width: 1fr; height: auto; min-height: 1; border: none; padding: 0 1; }
RadioSet { width: 1fr; height: auto; }
#error, #constraints { height: auto; color: $error; }
#actions { height: 3; margin: 1 2; align-horizontal: right; }
#actions Button { margin-left: 1; }
