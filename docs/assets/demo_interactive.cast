[20.0345, "o", "\u001b[?2004l\r\r\n"]
[20.3219, "o", "\u001b[1;36mGUIDE\u001b[0m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[1mRun the app\u001b[0m                                                                 \r\n  \u001b[2m`uv run` runs a command inside the project's environment, creating the \u001b[0m     \r\n  \u001b[2menvironment first if it is missing.\u001b[0m                                         \r\n  \u001b[1;36m    uv run demo-project\u001b[0m                                                     \r\n                                                                              \r\n  \u001b[1mWhere the code starts\u001b[0m                                                       \r\n  \u001b[2m`demo-project` runs `demo_project.cli:app`, defined in this file.\u001b[0m           \r\n      src/demo_project/cli.py                                                 \r\n                                                                              \r\n  \u001b[1mRun"]
[20.3219, "o", " the tests\u001b[0m                                                               \r\n  \u001b[2mpytest runs the project's tests and reports each one that fails.\u001b[0m            \r\n  \u001b[1;36m    just test\u001b[0m                                                               \r\n                                                                              \r\n  \u001b[1mCheck and format\u001b[0m                                                            \r\n  \u001b[2mFormatting rewrites code into one consistent style, linting flags likely \u001b[0m   \r\n  \u001b[2mbugs, and type checking catches a value used as the wrong type. `just ci` \u001b[0m  \r\n  \u001b[2mruns every check, as CI does. prek runs the project's git hooks on every \u001b[0m   \r\n  \u001b[2mcommit, and a failing hook stops the commit.\u001b[0m                                \r\n  \u001b[1;36m    just format\u001b[0m                                                             \r\n  \u001b[1;36m    just lint\u001b[0m                                                               \r\n  \u001b[1;36m    just typecheck\u001b[0m                                 "]
[20.3219, "o", "                         \r\n  \u001b[1;36m    just ci\u001b[0m                                                                 \r\n                                                                              \r\n  \u001b[1mPreview the docs\u001b[0m                                                            \r\n  \u001b[2mServes the documentation in `docs/` locally and reloads it as you edit.\u001b[0m     \r\n  \u001b[1;36m    just serve\u001b[0m                                                              \r\n                                                                              \r\n  \u001b[1mEverything else\u001b[0m                                                             \r\n  \u001b[2mLists every recipe in the justfile, with what each one does.\u001b[0m                \r\n  \u001b[1;36m    just --list\u001b[0m                                                             \r\n"]
[20.3433, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                             \r \r"]
[20.368, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J\r\n\u001b[1;36mdemo_project\u001b[0m on \u001b[1;35m\ue0a0 main\u001b[0m \u001b[1;31m[?]\u001b[0m via \u001b[1;34m\ud83d\udc33 orbstack\u001b[0m is \u001b[1;38;5;208m\ud83d\udce6 v0.1.0\u001b[0m via \u001b[1;33m\ud83d\udc0d v3.13.15 (demo-project) \u001b[0m\r\n\u001b[1;32m\u276f\u001b[0m \u001b[K\u001b[?2004h"]
