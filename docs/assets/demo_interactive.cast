[18.0053, "o", "\r\n\u001b[1;32mSUCCESS:\u001b[0m Project ready.\r\n"]
[18.0059, "o", "Run it with \u001b[1;36muv run demo-project\u001b[0m.\r\n\u001b[1;36mprotostar guide\u001b[0m shows how to test, check, and document it.\r\n"]
[18.1122, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                             \r \r"]
[18.1964, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J\r\n\u001b[1;36mdemo_project\u001b[0m on \u001b[1;35m\ue0a0 main\u001b[0m \u001b[1;31m[?]\u001b[0m via \u001b[1;34m\ud83d\udc33 orbstack\u001b[0m is \u001b[1;38;5;208m\ud83d\udce6 v0.1.0\u001b[0m via \u001b[1;33m\ud83d\udc0d v3.13.15 (demo-project) \u001b[0mtook \u001b[1;33m16s\u001b[0m \r\n\u001b[1;32m\u276f\u001b[0m \u001b[K\u001b[?2004h"]
[19.2657, "o", "\u001b[31mp\u001b[39m"]
