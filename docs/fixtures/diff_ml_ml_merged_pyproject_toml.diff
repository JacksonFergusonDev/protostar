--- a/pyproject.toml
+++ b/pyproject.toml
@@ -18,6 +18,7 @@
 email = "your-email"
 [dependency-groups]
 dev = [
+    "mypy>=2.3.1",
     "pytest>=9.1.1",
     "pytest-mock>=3.15.1",
     "ruff>=0.16.5",
@@ -64,3 +65,14 @@
 addopts = "--strict-markers"
 testpaths = ["tests"]
 pythonpath = ["."]
+
+[tool.mypy]
+mypy_path = "src"
